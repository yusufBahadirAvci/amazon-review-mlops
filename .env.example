# Copy to .env and fill in your own values: cp .env.example .env
# Used by docker-compose.yml (Postgres container) and app/config.py (FastAPI / SQLAlchemy).
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=change_me
# Host port for the Postgres container; change it if a local PostgreSQL already uses 5432
POSTGRES_PORT=5432
